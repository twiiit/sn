# nostr secret key of the bot account (@twiiit on stacker.news)
SN_NSEC=nsec1...

# Optional. Preferred nitter redirector; twiiit.com by default. Other redirectors
# from the shitter wiki are used automatically if this one is down.
# SN_REDIRECTOR=twiiit.com

# Optional. Log what would be posted without commenting.
# DRY_RUN=true

# Optional. Only consider posts younger than this (default 180). GitHub's
# scheduler delays or drops runs, so this window needs to be wider than the gap
# between two runs; the bot pages back far enough to cover it.
# ITEM_MAX_AGE_MINUTES=180

# Optional. Items per page (default and maximum 100, stacker.news rejects more),
# how many pages to read at most per run (default 5) and how many comments to
# post per run at most (default 20).
# MAX_ITEMS=100
# MAX_PAGES=5
# MAX_COMMENTS_PER_RUN=20

# Optional. Pause between comments in ms (default 5000).
# POST_DELAY_MS=5000

# Optional. Comments cost ~1 sat each, so the balance is roughly the number of
# replies left. stacker.news reports sats with the cowboy credits already folded
# in, so do not add them together. Below this many spendable sats, each reply gets
# a short footnote inviting readers to zap it. 0 disables the footer (default 100).
# SN_LOW_BALANCE_SATS=100

# Optional. Text of that footnote (default is the one in README).
# SN_FUNDING_FOOTER="bot · funded by zaps — zap this comment or send sats to twiiit@rizful.com"

# Optional. Replies are also published as nostr notes with SN_NSEC; the relays
# default to the ones stacker.news crossposts to. Comma separated to override.
# NOSTR_RELAYS=wss://relay.primal.net/,wss://relay.snort.social/

# Optional. Set to skip note publishing entirely.
# NOSTR_DISABLED=true

# Only needed for `npm run schedule`, which registers the external dispatcher
# (see "External dispatcher" in README). In CI these come from repository
# secrets of the same name; never commit them. DISPATCH_TOKEN cannot be called
# GITHUB_*, a prefix GitHub reserves for its own variables.
# DISPATCH_TOKEN=github_pat_...
# CRONJOB_API_KEY=...

# Optional. Overrides for that schedule (defaults shown).
# DISPATCH_REPO=twiiit/sn
# DISPATCH_REF=main
# DISPATCH_INTERVAL_MINUTES=5
