# nostr secret key of the bot account (@twiiit on stacker.news)
SN_NSEC=nsec1...

# Optional. Preferred nitter redirector; twiiit.com by default. Other redirectors
# from the shitter wiki are used automatically if this one is down.
# SN_REDIRECTOR=twiiit.com

# Optional. Log what would be posted without commenting.
# DRY_RUN=true

# Optional. Only consider posts younger than this (default 60).
# ITEM_MAX_AGE_MINUTES=60

# Optional. How many recent items to fetch (default 100) and how many comments
# to post per run at most (default 20).
# MAX_ITEMS=100
# MAX_COMMENTS_PER_RUN=20

# Optional. Pause between comments in ms (default 5000).
# POST_DELAY_MS=5000
